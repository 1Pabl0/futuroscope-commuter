# ==============================================================
# Futuroscope Commuter - Environment Configuration
# ==============================================================

# Application
PROJECT_NAME="Futuroscope Commuter API"
VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development
API_V1_STR="/api/v1"

# Server Host & Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Geolocation Coordinates (Technopole du Futuroscope, Grand Poitiers)
FUTUROSCOPE_LAT=46.6698
FUTUROSCOPE_LON=0.3621
POITIERS_LAT=46.5802
POITIERS_LON=0.3404

# Cache & Storage
# Redis is optional; if unreachable, automatic high-performance in-memory cache is used
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=180

# Database
# PostGIS for production, SQLite async fallback for local dev without Docker
DATABASE_URL=sqlite+aiosqlite:///./futuroscope.db
# DATABASE_URL=postgresql+asyncpg://commuter:commuter@localhost:5432/futuroscope_commuter

# Open Data APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Grand Poitiers / Vitalis Open Data (GTFS-RT)
VITALIS_API_KEY=
VITALIS_BASE_URL=https://data.grandpoitiers.fr/api

# SNCF Réseau / TER Nouvelle-Aquitaine
SNCF_API_KEY=
SNCF_BASE_URL=https://api.sncf.com/v1
